# Opcional. Solo hace falta si cambias los valores por defecto.

# URL base de la API que usa la webapp ya compilada. Por defecto "/api"
# (mismo dominio). Si el backend vive en otro dominio, indícalo aquí y añade el
# dominio de la webapp a CORS_ORIGINS en el backend.
# VITE_API_URL=https://api.ejemplo.com/api

# Destino del proxy /api en desarrollo (npm run dev). Por defecto el backend local.
# VITE_API_PROXY=http://localhost:3000
