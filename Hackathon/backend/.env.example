# Copia este archivo como backend/.env y rellena los valores.
#   cp .env.example .env        (desde la carpeta backend/)

# ── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos ────────────────────────────────────────────────────────────
# Usuario y contraseña deben coincidir con MONGO_USER / MONGO_PASSWORD del .env
# de la raíz (los usa docker-compose). Con Atlas, pega aquí tu cadena de conexión.
DATABASE_URL=mongodb://wa_agent:cambia-esta-clave@127.0.0.1:27017/whatsapp_agent?authSource=admin

# ── Sesiones del panel (JWT) ─────────────────────────────────────────────────
# Obligatorio, mínimo 32 caracteres. Genera uno con:  npm run secret
JWT_SECRET=
# Duración del enlace y de la sesión: segundos ("900") o con unidad ("15m", "1h").
JWT_EXPIRES=15m

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
# true = no se llama a Meta: los mensajes se muestran por consola y se habilitan
# las rutas /dev para probar sin cuenta de WhatsApp. Prohibido en producción.
WHATSAPP_MOCK=true
# Obligatorias cuando WHATSAPP_MOCK no es true:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Idioma por defecto de las plantillas (ej.: es, es_MX, en_US)
WHATSAPP_TEMPLATE_LANG=es

# ── LLM (API compatible con OpenAI) ──────────────────────────────────────────
# Sin clave, el agente responde solo por palabras clave.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# ── WebApp y CORS ────────────────────────────────────────────────────────────
WEBAPP_URL=http://localhost:5173
# Orígenes permitidos separados por comas. Por defecto, solo WEBAPP_URL.
# CORS_ORIGINS=http://localhost:5173

# ── Administración ───────────────────────────────────────────────────────────
# Clave para /api/admin y /api/notifications (cabecera X-Admin-Key), mínimo 24
# caracteres. Sin ella, esas rutas responden 503. Genera una con: npm run secret
ADMIN_API_KEY=

# ── Límites ──────────────────────────────────────────────────────────────────
# Mensajes de WhatsApp atendidos por usuario y minuto (controla el gasto en LLM).
MAX_MENSAJES_POR_MINUTO=20
# Peticiones a /api por IP y minuto.
MAX_PETICIONES_API_POR_MINUTO=120
# Si el backend está detrás de un proxy (ngrok, nginx...), indica cuántos saltos
# son de confianza para obtener la IP real del cliente (normalmente 1).
# TRUST_PROXY=1

# ── Puntos ───────────────────────────────────────────────────────────────────
# Puntos por cada unidad monetaria de una compra (0.1 = 1 punto cada 10).
PUNTOS_POR_UNIDAD=0.1
